# AI: mock(고정 샘플, 인터넷·Firebase 불필요) | gemini(실제 AI, 아래 Firebase 값 필요)
VITE_AI_MODE=mock
# Firebase 웹 앱 설정값 (영화 수업 설계 도우미와 같은 프로젝트·같은 웹 앱을 써도 된다)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check — 배포용 Fraud Defense 키 ID / 내 컴퓨터(npm run dev) 전용 디버그 토큰
VITE_RECAPTCHA_SITE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=
